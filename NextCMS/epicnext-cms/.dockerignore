.git
.gitignore
.next
node_modules
coverage
storage
prod.log
update.log
.pm2
# Only the pnpm lockfile is used. Ignore other lockfile formats and stray
# package managers so they never taint the build context by accident.
package-lock.json
yarn.lock
bun.lockb
.npmrc.bak
# Installation secrets must never enter any image layer (including migrations).
.env
.env.*
**/.env
**/.env.*
!.env.example
*.pem
*.key
*.tsbuildinfo
# Runtime write targets; bound as RW volumes at runtime (see docker-compose.yml)
public/nitro-assets
public/swf

# Testbronnen draaien op de host (pnpm test:ui / test:integration / test:e2e),
# de image heeft ze niet nodig. In de image zouden ze alleen de typecheck van
# `next build` meebepalen en de image van @playwright/test, vitest, msw,
# testcontainers en drizzle-kit afhankelijk maken.
e2e/
integration/

# Databasebackups (~232MB, dagelijkse rotatie): horen niet in de buildcontext.
# Ze maakten elke context groot en invalideerden bij elke rotatie de
# `COPY . .`-laag, waardoor de Next-build volledig opnieuw draaide.
backups/

# Wordt tijdens de build opnieuw gegenereerd door `pnpm assets:editor`
# (bron: node_modules/tinymce) en staat niet in git.
public/vendor/

# Lokale buildcache voor `docker compose build` (cache_from/cache_to).
.docker-cache/

.deploy.lock
logs

# Other installation data and local tool artifacts
public/cache
public/tmp
db_backup_*.sql
*.log
.codex
.agents

.docker-install
.docker-install.tmp.*
.env.install.*
build-reports
test-results
playwright-report
blob-report
