# Build output
**/bin/
**/obj/
# Publish output (generated by publish-*.sh / .bat)
/publish/
/.dotnet/

# Visual Studio user-specific files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
out/

# Visual Studio generated files
*.cache
*.pdb
*.ilk
*.obj
*.pch
*.idb
*.ipch
*.log

# Visual Studio generated folders
ipch/
.vscode/

# NuGet packages
packages/

# Test results
[Tt]est[Rr]esult*/

# OS junk
.DS_Store
Thumbs.db

# Client configuration: holds generated SSH private keys. Never commit it.
# (Specific patterns, so SourceCode/Configuration/ is not hit on case-insensitive file systems.)
/configuration/
**/configuration/keys/
**/configuration/database/

# NextCMS/ holds Node projects with their own .gitignore: the .NET and Visual Studio rules
# above must not drop their folders (a catalog "packages" folder was left out this way).
!NextCMS/**/packages/
!NextCMS/**/[Bb]in/
!NextCMS/**/[Oo]bj/
!NextCMS/**/[Dd]ebug/
!NextCMS/**/[Rr]elease/
!NextCMS/**/x64/
!NextCMS/**/x86/
!NextCMS/**/[Aa]rm/
!NextCMS/**/[Aa]rm64/
!NextCMS/**/configuration/
!NextCMS/**/*.cache
